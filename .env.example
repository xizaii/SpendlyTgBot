# ==========================================
# Пример файла конфигурации для бота учёта расходов
# Скопируйте этот файл в .env и укажите свои значения:
#   cp .env.example .env (Linux/macOS) или copy .env.example .env (Windows)
# ==========================================

# 1. Токен вашего Telegram-бота (получить у @BotFather)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 2. URL подключения к базе данных PostgreSQL (Neon, Supabase или локальная)
# Примечание: Для асинхронного драйвера используется префикс postgresql+asyncpg://
# Если хостинг выдал postgresql://..., приложение автоматически добавит +asyncpg.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# 3. Публичный URL вашего сервиса (куда Telegram будет слать обновления)
# На Render: https://your-app-name.onrender.com
# Для локальной разработки: URL из ngrok/cloudflared (например, https://abc-123.ngrok-free.app)
WEBHOOK_URL=https://your-app-name.onrender.com

# 4. Секретный токен для защиты вебхука (любая случайная строка из букв и цифр)
# Защищает эндпоинт от посторонних запросов, не являющихся запросами от Telegram
WEBHOOK_SECRET=my_super_secret_token_12345

# 5. Сетевые настройки веб-сервера
HOST=0.0.0.0
PORT=8000
